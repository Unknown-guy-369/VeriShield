# Server
PORT=4000
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
JSON_BODY_LIMIT_MB=1
TEXT_MAX_LENGTH=10000
IMAGE_MAX_MB=15
UPLOAD_MAX_MB=150

# Supabase PostgreSQL. Leave blank to use the in-memory development repository.
# Use a pooler-compatible URL when the deployment environment requires IPv4.
DATABASE_URL=

# Direct PostgreSQL URL used only by Alembic. Falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=

# Backend-only Supabase Storage credentials. Keep the bucket private.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=analysis-inputs

# Optional local-development override. Defaults to services/api/.data/uploads.
LOCAL_UPLOAD_DIR=.data/uploads
